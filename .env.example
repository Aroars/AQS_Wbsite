# Contact Form — Proxied to AQS Apps Backend
# The apps backend handles Resend email delivery
CONTACT_API_URL=https://apps.automatedqs.com/api/public/contact
CONTACT_API_KEY=your-shared-api-key-here

# Engineering toolbox — belt spec feed (read-only, engineering data only). Defaults to production.
# NEXT_PUBLIC_BELT_SPECS_URL=http://localhost:3000/api/public/belt-specs

# Analytics. Vercel Web Analytics needs no key: enable it on the Vercel project and the
# <Analytics /> component in src/app/layout.tsx starts reporting.
# Google Analytics 4 (loads only after the visitor accepts cookies). Property → Data Streams → Measurement ID.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Google Search Console: HTML-tag verification token (the content="…" value), or verify by DNS instead.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
